{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "price-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": {
    "enabled": true,
  },
  // Runs at 00:00, 04:00, 08:00, 12:00, 16:00 and 20:00 UTC.
  "triggers": {
    "crons": ["0 */4 * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "price-tracker",
      "database_id": "509d052e-1def-435e-8315-d378b0912108",
      "migrations_dir": "migrations",
    },
  ],
}
